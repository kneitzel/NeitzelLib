<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>

<fx:root type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml" spacing="6">
    <padding>
        <Insets top="4" right="4" bottom="4" left="4"/>
    </padding>
    <fx:define>
        <BindingList>
            <DirectBinding control="streetField" property="text" path="street" direction="both"/>
            <DirectBinding control="cityField" property="text" path="city" direction="both"/>
        </BindingList>
    </fx:define>
    <Label text="Street"/>
    <TextField fx:id="streetField" id="streetField"/>
    <Label text="City"/>
    <TextField fx:id="cityField" id="cityField"/>
</fx:root>
