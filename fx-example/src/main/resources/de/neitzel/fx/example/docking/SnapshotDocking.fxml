<?xml version="1.0" encoding="UTF-8"?>
<?import de.neitzel.fx.docking.DockPane?>
<?import de.neitzel.fx.docking.DockLayout?>
<?import de.neitzel.fx.docking.DockGroupDefinition?>
<?import de.neitzel.fx.docking.DockSplitDefinition?>
<DockPane xmlns:fx="http://javafx.com/fxml/1">
    <initialLayout>
        <DockLayout>
            <center>
                <DockSplitDefinition destinationId="editors" orientation="HORIZONTAL" position="0.55">
                    <first><DockGroupDefinition destinationId="primary"/></first>
                    <second>
                        <DockSplitDefinition destinationId="auxiliary" orientation="VERTICAL" position="0.6">
                            <first><DockGroupDefinition destinationId="secondary"/></first>
                            <second><DockGroupDefinition destinationId="preview"/></second>
                        </DockSplitDefinition>
                    </second>
                </DockSplitDefinition>
            </center>
            <right>
                <DockGroupDefinition destinationId="tools" tabSide="RIGHT" collapsible="true"
                    mode="OVERLAY" preferredWidth="240"/>
            </right>
        </DockLayout>
    </initialLayout>
</DockPane>
