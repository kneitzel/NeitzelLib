<?xml version="1.0" encoding="UTF-8"?>
<?import de.neitzel.fx.docking.DockPane?>
<?import de.neitzel.fx.docking.DockLayout?>
<?import de.neitzel.fx.docking.DockGroupDefinition?>
<DockPane xmlns:fx="http://javafx.com/fxml/1">
    <initialLayout>
        <DockLayout>
            <center><DockGroupDefinition destinationId="editors"/></center>
            <right><DockGroupDefinition destinationId="tools" tabSide="RIGHT" collapsible="true" preferredWidth="200" splitDirections="VERTICAL"
                visibleWhenEmpty="false" releaseSpaceWhenEmpty="true"/></right>
        </DockLayout>
    </initialLayout>
</DockPane>
