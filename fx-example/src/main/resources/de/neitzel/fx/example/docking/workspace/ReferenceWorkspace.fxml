<?xml version="1.0" encoding="UTF-8"?>
<?import de.neitzel.fx.docking.*?>
<DockPane id="workspaceDock" xmlns:fx="http://javafx.com/fxml/1">
    <initialLayout><DockLayout>
        <center><DockGroupDefinition destinationId="editors"/></center>
        <left><DockGroupDefinition destinationId="project" tabSide="LEFT" collapsible="true"
            preferredWidth="240" visibleWhenEmpty="false" releaseSpaceWhenEmpty="true"/></left>
        <right><DockGroupDefinition destinationId="changes" tabSide="RIGHT" collapsible="true" mode="OVERLAY"
            preferredWidth="220" visibleWhenEmpty="false" releaseSpaceWhenEmpty="true"/></right>
        <bottom><DockGroupDefinition destinationId="bottom" collapsible="true" preferredHeight="160"
            visibleWhenEmpty="false" releaseSpaceWhenEmpty="true"/></bottom>
    </DockLayout></initialLayout>
</DockPane>
