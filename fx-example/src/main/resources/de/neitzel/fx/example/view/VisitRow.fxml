<?xml version="1.0" encoding="UTF-8"?>
<?neitzel-model de.neitzel.fx.example.model.Address?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>

<fx:root type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml/1" spacing="8">
    <fx:define>
        <BindingList>
            <DirectBinding control="streetField" property="text" path="street" direction="both"/>
            <DirectBinding control="cityField" property="text" path="city" direction="both"/>
            <DirectBinding control="visitedField" property="text" path="visitedOn" direction="both"
                           converter="de.neitzel.fx.example.view.VisitedOnConverter"/>
        </BindingList>
    </fx:define>
    <TextField fx:id="streetField" id="streetField"/>
    <TextField fx:id="cityField" id="cityField"/>
    <TextField fx:id="visitedField" id="visitedField"/>
    <Button text="Remove" onAction="#remove"/>
</fx:root>
