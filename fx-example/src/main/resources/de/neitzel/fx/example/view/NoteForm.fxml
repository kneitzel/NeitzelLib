<?xml version="1.0" encoding="UTF-8"?>
<?neitzel-model de.neitzel.fx.example.model.Note?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>

<fx:root type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml/1" spacing="6">
    <fx:define>
        <BindingList>
            <DirectBinding control="noteField" property="text" path="text" direction="both"/>
        </BindingList>
    </fx:define>
    <Label text="Note"/>
    <TextField fx:id="noteField" id="noteField"/>
</fx:root>
