<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
        <BindingList>
            <DirectBinding control="streetField" property="text" path="person.address.street" direction="both"
                           converter="de.neitzel.fx.view.fixture.CheckedStreetConverter"/>
        </BindingList>
    </fx:define>
    <TextField fx:id="streetField" id="streetField"/>
</VBox>
