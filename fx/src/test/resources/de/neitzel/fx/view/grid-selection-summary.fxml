<?xml version="1.0" encoding="UTF-8"?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.neitzel.fx.view.selection.SelectionSummaryController">
    <fx:define>
        <BindingList>
            <DirectBinding control="summary" property="text" path="summary" direction="view"/>
        </BindingList>
    </fx:define>
    <Label fx:id="summary"/>
</VBox>
