<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
        <BindingList>
            <DirectBinding control="nameField" property="text" path="name" direction="both"/>
            <DirectBinding control="nameLabel" property="text" path="name" direction="view"/>
        </BindingList>
    </fx:define>
    <TextField fx:id="nameField" id="nameField"/>
    <Label fx:id="nameLabel" id="nameLabel"/>
</VBox>
