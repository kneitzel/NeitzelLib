<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>
<?import de.neitzel.fx.view.fixture.ObjectHolder?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
        <BindingList>
            <DirectBinding control="addressHolder" property="value" path="address" direction="both"/>
        </BindingList>
    </fx:define>
    <ObjectHolder fx:id="addressHolder" id="addressHolder"/>
</VBox>
