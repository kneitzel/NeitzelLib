<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>
<?import de.neitzel.fx.view.chosen.CaptionAddressForm?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
        <BindingList>
            <DirectBinding control="addressForm" property="model" path="address" direction="both"/>
        </BindingList>
    </fx:define>
    <CaptionAddressForm fx:id="addressForm"/>
</StackPane>
