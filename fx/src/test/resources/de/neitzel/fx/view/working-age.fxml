<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.ComputedBinding?>
<?import de.neitzel.fx.view.DirectBinding?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="de.neitzel.fx.view.computed.WorkingAgeController">
    <fx:define>
        <BindingList>
            <DirectBinding control="nameField" property="text" path="name" direction="both"/>
            <ComputedBinding control="workingAgeLabel" property="text" method="#workingAge"/>
        </BindingList>
    </fx:define>
    <TextField fx:id="nameField" id="nameField"/>
    <Label fx:id="workingAgeLabel" id="workingAgeLabel"/>
</VBox>
