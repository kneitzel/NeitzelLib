<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<fx:root type="javafx.scene.layout.VBox" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <BindingList><DirectBinding control="name" property="text" path="name" direction="view"/></BindingList>
    </fx:define>
    <Label fx:id="name"/>
</fx:root>
